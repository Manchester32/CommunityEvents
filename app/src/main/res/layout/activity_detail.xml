<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F8F6">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <Button android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Events" android:textAllCaps="false" android:backgroundTint="#166B61" />
    <ImageView android:id="@+id/detailImage" android:layout_width="match_parent" android:layout_height="210dp" android:scaleType="centerCrop" android:contentDescription="Event picture" android:visibility="gone" />
    <TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" android:textColor="#124F49" android:layout_marginTop="18dp" />
    <TextView android:id="@+id/detailDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#166B61" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/detailLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#166B61" android:layout_marginTop="12dp" />
    <TextView android:id="@+id/detailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#324D45" android:layout_marginTop="24dp" />
</LinearLayout>
</ScrollView>
